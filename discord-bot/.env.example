# Token du bot — Discord Developer Portal > Applications > ton app > Bot > Reset Token
DISCORD_TOKEN=

# Application ID — Discord Developer Portal > ton app > General Information > Application ID
DISCORD_CLIENT_ID=

# Optionnel : ID d'un serveur Discord pour enregistrer les commandes instantanément
# pendant le dev (sinon les commandes globales mettent jusqu'à 1h à apparaître).
DISCORD_GUILD_ID=

# Optionnel : override de l'URL du roster (par défaut, le roster public du site OLYCITY)
# ROSTER_URL=https://tracker.olycity.fr/data/roster.json

# Optionnel : ID d'un salon Discord où le bot poste ses erreurs fatales
# (clic droit sur le salon > Copier l'ID, mode développeur Discord activé).
# DISCORD_LOG_CHANNEL_ID=

# Résultats supprimés : le bot les reposte avec « Bien essayé @… ». Pour
# savoir QUI a supprimé, il lui faut la permission « Voir les logs du
# serveur ». Ces identifiants Discord (séparés par des virgules) peuvent
# retirer un résultat sans qu'il revienne — un admin qui corrige une erreur.
# RESULT_DELETE_ALLOWED_IDS=
