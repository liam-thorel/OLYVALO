{
  "name": "olycity-overlay",
  "productName": "OLYCITY Overlay",
  "version": "1.1.0",
  "description": "Le site OLYCITY en surimpression, au lancement du jeu ou au raccourci clavier",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "43.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "gg.olycity.overlay",
    "productName": "OLYCITY Overlay",
    "files": ["main.js", "preload.js", "lib/**/*", "ui/**/*"],
    "publish": [
      { "provider": "github", "owner": "liam-thorel", "repo": "OLYVALO" }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "OLYCITY-Overlay-Setup.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "artifactName": "OLYCITY-Overlay-Setup.exe",
      "differentialPackage": true
    }
  }
}
